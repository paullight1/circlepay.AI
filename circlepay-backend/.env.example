# ── Server ──
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (Expo web dev server, etc.)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ── Database (matches docker-compose.yml) ──
DATABASE_URL=postgres://circlepay:circlepay@localhost:5433/circlepay

# ── Auth ──
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=30d
# In dev, OTPs are returned in the response and logged instead of sent by SMS.
OTP_DEV_MODE=true
